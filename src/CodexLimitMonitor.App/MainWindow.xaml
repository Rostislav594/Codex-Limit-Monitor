<Window x:Class="CodexLimitMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:CodexLimitMonitor.App.Controls"
        mc:Ignorable="d"
        Title="Codex Limit Monitor"
        Width="326"
        Height="302"
        MinWidth="220"
        MinHeight="82"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="HoverControlsStyle" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpandedHoverControlsStyle"
               TargetType="StackPanel"
               BasedOn="{StaticResource HoverControlsStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpandedVisibilityStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactVisibilityStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="Card"
                CornerRadius="24"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#F21C2028" />
                    <GradientStop Offset="0.62" Color="#F2171A21" />
                    <GradientStop Offset="1" Color="#F212151B" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  Direction="270"
                                  ShadowDepth="8"
                                  Color="#B0000000"
                                  Opacity="0.58" />
            </Border.Effect>

            <Grid>
                <Border Margin="1"
                        VerticalAlignment="Top"
                        Height="54"
                        CornerRadius="23,23,16,16"
                        Background="#08FFFFFF"
                        IsHitTestVisible="False" />

                <Grid Margin="20,18,20,18"
                      Style="{StaticResource ExpandedVisibilityStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="34"
                                Height="34"
                                CornerRadius="11"
                                Background="#16FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1">
                            <TextBlock Text=">_"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="10,1,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="CODEX"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock Text="LIMIT MONITOR"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Height="24"
                                Padding="8,0"
                                VerticalAlignment="Center"
                                CornerRadius="8"
                                Background="#0FFFFFFF"
                                BorderBrush="#16FFFFFF"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6"
                                         Height="6"
                                         Margin="0,0,6,0"
                                         Fill="{Binding StatusBrush}" />
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,4">
                        <Grid Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="162" Height="162" HorizontalAlignment="Center">
                                <controls:ArcGauge Margin="8"
                                                   Value="{Binding PrimaryBucket.RemainingPercent}"
                                                   Foreground="{Binding PrimaryBucket.AccentBrush}"
                                                   Track="{StaticResource TrackBrush}"
                                                   StrokeThickness="10" />
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,7,0,0">
                                    <TextBlock Text="{Binding PrimaryBucket.PercentageText}"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="35"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Display, Segoe UI" />
                                    <TextBlock Text="ОСТАЛОСЬ"
                                               Margin="0,1,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <StackPanel VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,-5">
                                <TextBlock Text="{Binding PrimaryBucket.DisplayName}"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PrimaryBucket.CountdownText}"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding ShowResetCountdown, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10" />
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="16"
                                Background="#0CFFFFFF"
                                BorderBrush="#12FFFFFF"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="18">
                                <Ellipse Width="10"
                                         Height="10"
                                         Fill="{Binding StatusBrush}" />
                                <TextBlock Text="{Binding StatusText}"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DiagnosticMessage, TargetNullValue=Получение данных Codex…}"
                                           Margin="0,6,0,0"
                                           MaxWidth="220"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           LineHeight="15" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding SecondaryBuckets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="52"
                                        Margin="0,6,0,0"
                                        Padding="10,7"
                                        CornerRadius="14"
                                        Background="#0AFFFFFF"
                                        BorderBrush="#12FFFFFF"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="34" Height="34">
                                            <controls:ArcGauge Value="{Binding RemainingPercent}"
                                                               Foreground="{Binding AccentBrush}"
                                                               Track="{StaticResource TrackBrush}"
                                                               StrokeThickness="4" />
                                        </Grid>
                                        <StackPanel Grid.Column="1"
                                                    Margin="9,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CountdownText}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding DataContext.ShowResetCountdown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="9" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PercentageText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding AccentBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid Margin="14,12"
                      Style="{StaticResource CompactVisibilityStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="52" Height="52" VerticalAlignment="Center">
                        <controls:ArcGauge Value="{Binding PrimaryBucket.RemainingPercent}"
                                           Foreground="{Binding PrimaryBucket.AccentBrush}"
                                           Track="{StaticResource TrackBrush}"
                                           StrokeThickness="5" />
                        <TextBlock Text="{Binding PrimaryBucket.PercentageText, TargetNullValue=—}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=">_"
                                       Margin="0,0,6,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="CODEX"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <Ellipse Width="5"
                                     Height="5"
                                     Margin="7,0,0,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding StatusBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PrimaryBucket.DisplayName, TargetNullValue=Подключение…}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="9" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Style="{StaticResource HoverControlsStyle}">
                        <Button Content="×"
                                AutomationProperties.AutomationId="BtnHideCompact"
                                Style="{StaticResource HudIconButtonStyle}"
                                FontSize="15"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,52,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Style="{StaticResource ExpandedHoverControlsStyle}">
                    <Button Content="↻"
                            AutomationProperties.AutomationId="BtnRefresh"
                            ToolTip="Обновить сейчас"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource HudIconButtonStyle}"
                            FontSize="13" />
                    <Button Content="⌁"
                            AutomationProperties.AutomationId="BtnCompact"
                            ToolTip="Компактный режим"
                            Command="{Binding ToggleModeCommand}"
                            Style="{StaticResource HudIconButtonStyle}"
                            FontSize="13" />
                    <Button Content="×"
                            AutomationProperties.AutomationId="BtnHideExpanded"
                            ToolTip="Закрыть"
                            Style="{StaticResource HudIconButtonStyle}"
                            FontSize="15"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
