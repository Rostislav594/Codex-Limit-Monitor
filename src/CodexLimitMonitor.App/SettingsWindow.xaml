<Window x:Class="CodexLimitMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Настройки Codex Limit Monitor"
        Width="466"
        Height="570"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF171A21"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#32FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="16" Background="#FF171A21">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0,12,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="НАСТРОЙКИ" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Codex Limit Monitor" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="×"
                        Width="32"
                        Height="32"
                        FontSize="16"
                        Style="{StaticResource HudIconButtonStyle}"
                        automation:AutomationProperties.AutomationId="BtnSettingsClose"
                        Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,8,24,10">
                    <TextBlock Text="Внешний вид" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Margin="0,5,0,0" Text="Прозрачность виджета" Style="{StaticResource SettingHintStyle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="54" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="35"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding OpacityPercent, UpdateSourceTrigger=PropertyChanged}"
                                automation:AutomationProperties.AutomationId="SldOpacity" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding OpacityPercent, StringFormat={}{0:F0}%}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                    <CheckBox Content="Компактный режим"
                              IsChecked="{Binding IsCompact}"
                              automation:AutomationProperties.AutomationId="ChkCompact" />
                    <CheckBox Content="Всегда поверх окон"
                              IsChecked="{Binding IsTopmost}"
                              automation:AutomationProperties.AutomationId="ChkTopmost" />
                    <CheckBox Content="Показывать обратный отсчёт до сброса"
                              IsChecked="{Binding ShowResetCountdown}"
                              automation:AutomationProperties.AutomationId="ChkCountdown" />

                    <Border Height="1" Margin="0,20,0,18" Background="#16FFFFFF" />

                    <TextBlock Text="Обновление" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Margin="0,5,0,0" Text="Период полной синхронизации с Codex App Server" Style="{StaticResource SettingHintStyle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="62" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="15"
                                Maximum="300"
                                TickFrequency="15"
                                IsSnapToTickEnabled="True"
                                Value="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                automation:AutomationProperties.AutomationId="SldRefreshInterval" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RefreshIntervalSeconds, StringFormat={}{0:F0} сек}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <Border Height="1" Margin="0,20,0,18" Background="#16FFFFFF" />

                    <TextBlock Text="Запуск" Style="{StaticResource SettingLabelStyle}" />
                    <CheckBox Content="Запускать вместе с Windows"
                              IsChecked="{Binding StartWithWindows}"
                              automation:AutomationProperties.AutomationId="ChkAutostart" />
                    <CheckBox Content="Запускать со скрытым виджетом"
                              IsChecked="{Binding StartMinimized}"
                              automation:AutomationProperties.AutomationId="ChkStartMinimized" />
                    <TextBlock Margin="0,10,0,0"
                               Text="Автозапуск создаётся только для текущего пользователя и не требует прав администратора."
                               Style="{StaticResource SettingHintStyle}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="24,14,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Content="Отмена"
                        Style="{StaticResource SettingsButtonStyle}"
                        automation:AutomationProperties.AutomationId="BtnSettingsCancel"
                        Click="Cancel_Click" />
                <Button Grid.Column="3"
                        Content="Сохранить"
                        Background="#FF3B8F64"
                        BorderBrush="#FF55B982"
                        Style="{StaticResource SettingsButtonStyle}"
                        automation:AutomationProperties.AutomationId="BtnSettingsSave"
                        Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
