<Window x:Class="CodexLimitMonitor.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диагностика Codex Limit Monitor"
        Width="680"
        Height="590"
        MinWidth="620"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF171A21"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="DiagnosticCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0CFFFFFF" />
            <Setter Property="BorderBrush" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="DiagnosticButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="16" Background="#FF171A21">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0,12,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ДИАГНОСТИКА" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Локальное состояние без секретов и данных аккаунта"
                               Margin="0,3,0,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="32"
                        Height="32"
                        Content="×"
                        FontSize="16"
                        Style="{StaticResource HudIconButtonStyle}"
                        AutomationProperties.AutomationId="BtnDiagnosticsClose"
                        Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="22,4,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DiagnosticCardStyle}">
                    <StackPanel>
                        <TextBlock Text="СОСТОЯНИЕ" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding StateText}"
                                   Margin="0,6,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="TxtDiagnosticState" />
                        <TextBlock Text="{Binding LastRefreshText, StringFormat=Обновлено: {0}}"
                                   Margin="0,4,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DiagnosticCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ПОДКЛЮЧЕНИЯ" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding ConnectionAttempts}"
                                   Margin="0,6,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ReconnectCount, StringFormat=восстановлений: {0}}"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DiagnosticCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ПРОТОКОЛ" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding ProtocolIssues}"
                                   Margin="0,6,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StderrLines, StringFormat=stderr-строк: {0}}"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="22,0,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Журнал событий" FontSize="12" FontWeight="SemiBold" />
                <Border Grid.Row="1"
                        Margin="0,9,0,8"
                        CornerRadius="12"
                        Background="#FF11141A"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="1">
                    <ListBox ItemsSource="{Binding RecentLogLines}"
                             Padding="12,8"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="LstDiagnosticLog" />
                </Border>
                <TextBlock Grid.Row="2"
                           Text="{Binding LogPath}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LogPath}"
                           FontSize="9"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>

            <Grid Grid.Row="3" Margin="22,12,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Значения лимитов и данные аккаунта в журнал не записываются."
                           VerticalAlignment="Center"
                           FontSize="9"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Button Grid.Column="1"
                        Content="Переподключить"
                        Command="{Binding ReconnectCommand}"
                        Style="{StaticResource DiagnosticButtonStyle}"
                        AutomationProperties.AutomationId="BtnReconnect" />
                <Button Grid.Column="2"
                        Content="Копировать сводку"
                        Command="{Binding CopySummaryCommand}"
                        Style="{StaticResource DiagnosticButtonStyle}"
                        AutomationProperties.AutomationId="BtnCopyDiagnostics" />
                <Button Grid.Column="3"
                        Content="Открыть лог"
                        Command="{Binding OpenLogFolderCommand}"
                        Style="{StaticResource DiagnosticButtonStyle}"
                        AutomationProperties.AutomationId="BtnOpenLog" />
            </Grid>
        </Grid>
    </Border>
</Window>
